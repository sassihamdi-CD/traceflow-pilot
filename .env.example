# TraceFlow API — copy to .env.<company> per manufacturer company and fill in.
# SEPARATE DATABASE per company (decision 2026-10-07): one .env file, one
# DATABASE_URL, one WORKSPACE_ID per company. Never share a DB across companies.
# See docs/COMPANY_PROVISIONING.md for the full per-company checklist.
DATABASE_URL=postgresql://traceflow_app:change-me@localhost:5432/traceflow
# Local-only Postgres app password used by docker-compose (never commit a real one).
DB_APP_PASSWORD=change-me-local-only
SUPABASE_URL=https://xyz.supabase.co
# Server validates sessions via the Supabase Auth API; no JWT secret needed.
SUPABASE_ANON_KEY=change-me
# Correction 3: single-workspace pilot — hardcoded workspace id, no user->workspace lookup table
# Per-company: generate ONE uuid per company (uuidgen) and seed it via provisioning.
# Seeded by migrations/013_pilot_workspace.sql — change BOTH the seed and this
# value together when provisioning a new company, or every write returns 409.
WORKSPACE_ID=4db22bd4-77a6-4013-91c7-7e8936680909
# R2 object prefix per company: {WORKSPACE_ID}/{product_id}/{uuid}-{basename}.
# One shared bucket is OK; isolation comes from the workspace prefix.
# Never reuse a prefix across companies.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
# One shared bucket is OK; isolation comes from the workspace prefix.
R2_BUCKET=traceflow-docs
ANTHROPIC_API_KEY=sk-ant-change-me
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Comma-separated browser origins allowed via CORS (no cookies/credentials; Bearer only).
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Shared secret for POST /api/intake/email (email provider webhook). Empty = 503.
# Per-company: generate a fresh 32-byte secret per company (openssl rand -hex 32).
INTAKE_SECRET=change-me
# TraceFlow founder key (SERVER-ONLY, never NEXT_PUBLIC_): unlocks /founder
# + /api/founder/* where company codes are minted. Empty = founder area off.
FOUNDER_KEY=change-me-server-side-only
# Shared secret for POST /api/worker/tick. Vercel cannot run a long-lived
# worker, so Supabase pg_cron + pg_net (or any external scheduler) calls this
# endpoint every minute to drain extraction_jobs. Empty = endpoint disabled.
WORKER_SECRET=change-me-worker-only
# Standalone worker parallelism (1-16). Vercel tick always processes one job.
WORKER_CONCURRENCY=2
# API DB pool per process. Serverless (Vercel) must stay low (2). A dedicated
# API host (Fly/Railway/VM) can use 10-20 with a direct/pooled Postgres plan.
DB_POOL_MAX_SIZE=2
PORT=8000
# Pilot console (Next.js) served by `docker compose up` on WEB_PORT.
WEB_PORT=3000
# Frontend build args (baked into the web image at build time — re-run
# `docker compose up --build` after changing them).
# Local demo mode (NEVER true in production): bypasses Supabase auth, R2
# storage and Anthropic. Uploads go to a shared api/worker volume and
# extraction is deterministic. Set NEXT_PUBLIC_DEMO_MODE at web BUILD time.
DEMO_MODE=false
DEMO_STORAGE_DIR=/srv/app/uploads
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side (SSR) API URL used by the Next.js container. docker-compose
# overrides this with http://api:8000; localhost is for `next dev` on the host.
API_URL_INTERNAL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me

# --- Optional second company stack (docker-compose.company-b.yml) ----------
# Each company gets its OWN database/password/ports. Leave these unset when
# running only the default stack.
# DB_APP_PASSWORD_B=change-me-local-only
# PORT_B=8002
# WEB_PORT_B=3002
# NEXT_PUBLIC_API_URL_B=http://localhost:8002
